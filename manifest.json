{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.dbx.ratel",
  "name": "Ratel 摸鱼台",
  "version": "0.1.4",
  "publisher": "mikodream",
  "description": "连接 Ratel 在线棋牌（斗地主/跑得快/德州/大众麻将等）的摸鱼客户端。WebSocket 长连接 + 快捷命令面板。",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/mikodream/ratel-dbx",
  "homepage": "https://github.com/mikodream/ratel-dbx",
  "engines": {
    "host_api": "1"
  },
  "permissions": [
    "host.events",
    "host.storage",
    "host.workbench"
  ],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    },
    "backend": {
      "protocol_versions": [
        1
      ],
      "transport": "stdio-jsonl",
      "executable": "bin/windows-x64/ratel-dbx.exe"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.dbx.ratel.main",
      "label": "Ratel 摸鱼台",
      "description": "连接 Ratel 在线棋牌，玩斗地主/跑得快/德州/大众麻将。",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "command",
      "id": "com.dbx.ratel.open",
      "label": "Ratel 摸鱼台",
      "description": "打开 Ratel 棋牌摸鱼台",
      "icon": "assets/plugin.svg",
      "action": {
        "type": "open-workbench",
        "workbench": "com.dbx.ratel.main",
        "presentation": "tab",
        "reuse": "singleton"
      }
    },
    {
      "type": "menus",
      "id": "com.dbx.ratel.menus",
      "items": [
        {
          "location": "appToolbar",
          "command": "com.dbx.ratel.open",
          "group": "navigation",
          "order": 0,
          "default_visible": true
        },
        {
          "location": "appSidebar",
          "command": "com.dbx.ratel.open",
          "group": "navigation",
          "order": 0,
          "default_visible": true
        },
        {
          "location": "commandPalette",
          "command": "com.dbx.ratel.open",
          "group": "navigation",
          "order": 0
        }
      ]
    }
  ]
}
